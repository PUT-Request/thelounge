{
  "name": "thelounge",
  "description": "The self-hosted Web IRC client",
  "version": "4.6.0-pre.1",
  "type": "commonjs",
  "preferGlobal": true,
  "bin": {
    "thelounge": "index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thelounge/thelounge.git"
  },
  "homepage": "https://thelounge.chat/",
  "scripts": {
    "build:client": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "run-p --aggregate-output build:client build:server",
    "coverage": "vitest run --coverage --coverage.provider=istanbul",
    "dev": "cross-env NODE_ENV=development ts-node --project server/tsconfig.json server/index.ts start --dev",
    "format:prettier": "prettier --write \"**/*.*\"",
    "generate:config:doc": "ts-node scripts/generate-config-doc.js",
    "lint:check-eslint": "eslint-config-prettier eslint.config.mjs",
    "lint:eslint": "eslint . --report-unused-disable-directives --color",
    "lint:prettier": "prettier --list-different \"**/*.*\"",
    "lint:stylelint": "stylelint --color \"client/**/*.css\"",
    "lint": "run-p --aggregate-output --continue-on-error lint:*",
    "start": "node index start",
    "test": "run-s build test:checks",
    "test:checks": "run-p --aggregate-output --continue-on-error lint:* test:vitest",
    "test:vitest": "vitest run",
    "watch": "vite build --watch",
    "githooks-install": "git config core.hooksPath scripts/git-hooks"
  },
  "keywords": [
    "lounge",
    "browser",
    "web",
    "chat",
    "client",
    "irc",
    "server",
    "thelounge"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "resolutions": {
    "browserslist": "^4.28.8",
    "eslint/**/brace-expansion": "1.1.18",
    "fast-uri": "3.1.6",
    "ip-address": "^10.7.0",
    "js-yaml": "^4.3.2",
    "nanoid": "3.3.18",
    "postcss": "^8.5.23",
    "socket.io-parser": "4.2.7",
    "svgo": "2.8.3",
    "ws": "^8.21.0"
  },
  "files": [
    "./.thelounge_home",
    "./index.js",
    "./yarn.lock",
    "./dist/package.json",
    "./dist/**/*.js",
    "./public/**"
  ],
  "dependencies": {
    "@fastify/busboy": "3.2.0",
    "@tanstack/vue-virtual": "^3",
    "bcryptjs": "3.0.3",
    "chalk": "4.1.2",
    "cheerio": "1.2.0",
    "commander": "15.0.0",
    "compression": "1.8.1",
    "content-disposition": "0.5.4",
    "express": "5.1.0",
    "file-type": "21.3.2",
    "filenamify": "4.3.0",
    "got": "11.8.6",
    "irc-framework": "github:kiwiirc/irc-framework#69d47d1",
    "ldapts": "9.0.0",
    "linkify-it": "6.1.0",
    "lodash": "4.18.1",
    "mime-types": "3.0.2",
    "node-forge": "1.4.0",
    "package-json": "7.0.0",
    "read": "6.0.0",
    "semver": "7.8.5",
    "socket.io": "4.8.3",
    "tlds": "1.261.0",
    "ua-parser-js": "2.0.10",
    "undici": "7.29.1",
    "web-push-neo": "0.1.2",
    "whatwg-mimetype": "5.0.0",
    "yarn": "1.22.22"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fortawesome/fontawesome-free": "5.15.4",
    "@textcomplete/core": "0.1.13",
    "@textcomplete/textarea": "0.1.13",
    "@types/content-disposition": "0.5.8",
    "@types/express": "^5.0.0",
    "@types/ldapjs": "2.2.5",
    "@types/lodash": "4.17.25",
    "@types/mime-types": "3.0.1",
    "@types/mousetrap": "1.6.15",
    "@types/node": "26.4.1",
    "@types/semver": "7.8.0",
    "@types/sortablejs": "1.15.8",
    "@types/whatwg-mimetype": "5.0.0",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-istanbul": "^5.0.0",
    "@vue/compiler-dom": "3.5.42",
    "@vue/runtime-dom": "3.5.42",
    "@vue/test-utils": "2.5.0",
    "cross-env": "10.1.0",
    "cssnano": "5.0.17",
    "dayjs": "1.11.23",
    "emoji-regex": "10.6.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "9.25.0",
    "fuzzy": "0.1.3",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "ldapjs": "2.3.3",
    "mousetrap": "1.6.5",
    "normalize.css": "8.0.1",
    "npm-run-all2": "9.0.3",
    "postcss": "8.5.23",
    "postcss-import": "14.0.2",
    "postcss-preset-env": "7.3.0",
    "prettier": "3.9.6",
    "pretty-quick": "4.2.2",
    "primer-tooltips": "2.0.0",
    "sinon": "22.1.0",
    "socket.io-client": "4.8.3",
    "sortablejs": "1.15.7",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "ts-node": "10.9.2",
    "ts-sinon": "2.0.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "undate": "0.3.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue": "3.5.42",
    "vue-eslint-parser": "9.4.3",
    "vue-router": "5.3.1",
    "vuex": "4.0.2"
  }
}
